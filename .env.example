# Contact form delivery — internal notification email via Web3Forms.
# Get the access key from https://web3forms.com (tied to Ryan's inbox).
# Email recipient is configured on the Web3Forms account, not here.
WEB3FORMS_ACCESS_KEY=

# Contact form delivery — firsthand-ops website-lead webhook.
# Where to POST the inquiry as JSON. Points at
# https://<firsthand-ops-admin>/api/webhooks/website-lead which forwards
# the lead to Jobber via clientLookupOrCreate + requestCreate.
JOBBER_WEBHOOK_URL=
# Shared secret used to sign the request body as HMAC-SHA256 in the
# X-Hub-Signature-256 header. MUST match WEBSITE_LEAD_WEBHOOK_SECRET on
# the firsthand-ops side or the webhook will 401. Required when
# JOBBER_WEBHOOK_URL is set.
WEBSITE_LEAD_WEBHOOK_SECRET=

# Meta (Facebook) Pixel ID — fires PageView (cookie-consent gated) and Lead
# on contact form submit. If unset, app/layout.tsx falls back to a
# PLACEHOLDER_* sentinel that keeps the pixel script dormant.
NEXT_PUBLIC_META_PIXEL_ID=
