# Contact form delivery — internal notification email via Resend.
# Sender domain must be verified in the Resend dashboard before sends
# will succeed in production.
RESEND_API_KEY=
RESEND_FROM="Firsthand Lawns <hello@firsthandlawns.com>"
CONTACT_INTERNAL_TO=admin@firsthandlawns.com

# Contact form delivery — Jobber webhook.
# Where to POST the inquiry as JSON. Typically an n8n webhook URL that
# downstream creates a Jobber request via the Jobber GraphQL API.
JOBBER_WEBHOOK_URL=
# Optional shared secret sent as X-Webhook-Secret header so the
# receiver can reject unauthenticated calls.
JOBBER_WEBHOOK_SECRET=
